{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python 调试程序: 包含参数的当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "${command:pickArgs}"
            ]
        },
        {
            "name": "Python 调试程序: CHESS_IR_SS_CG.yaml",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                // "-u", "./src/main.py",
                "--data_mode", "dev",
                "--data_path", "./data/dev/dev.json",
                "--config", "./run/configs/CHESS_IR_SS_CG.yaml",
                "--num_workers", "1",
                "--pick_final_sql", "true"
            ],
            "envFile": "${workspaceFolder}/.env"
        },
    ]
}